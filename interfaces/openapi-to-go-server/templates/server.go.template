func (s *APIRouter) MatchRoute(r *http.Request) (bool, *<API_PACKAGE>.Route) {
	for _, route := range s.Routes {
		if route.Method == r.Method && route.Pattern.MatchString(r.URL.Path) {
			return true, route
		}
	}
	return false, nil
}

